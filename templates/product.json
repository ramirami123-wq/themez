        "custom_liquid": "<style>\n.benefits-table {\n  width: 100%;\n  max-width: 700px;\n  margin: 25px auto;\n  border-collapse: collapse;\n  font-family: inherit;\n  text-align: center;\n}\n\n.benefits-table th {\n  background: #264854;\n  color: #fff;\n  padding: 14px;\n  font-size: 16px;\n}\n\n.benefits-table td {\n  border: 1px solid #ddd;\n  padding: 14px;\n  font-size: 15px;\n}\n\n.benefits-table tr:nth-child(even) {\n  background: #f7f7f7;\n}\n\n.benefit-name {\n  text-align: left;\n  font-weight: 600;\n}\n\n.yes {\n  color: #16a34a;\n  font-weight: 700;\n}\n\n.no {\n  color: #dc2626;\n  font-weight: 700;\n}\n</style>\n\n<table class=\"benefits-table\">\n  <tr>\n    <th>Benefits</th>\n    <th>Us</th>\n    <th>Others</th>\n  </tr>\n\n  <tr>\n    <td class=\"benefit-name\">3-in-1 Vacuum + Blower</td>\n    <td class=\"yes\">Yes</td>\n    <td class=\"no\">No</td>\n  </tr>\n\n  <tr>\n    <td class=\"benefit-name\">Multiple Cleaning Heads</td>\n    <td class=\"yes\">Yes</td>\n    <td class=\"no\">No</td>\n  </tr>\n\n  <tr>\n    <td class=\"benefit-name\">Compact & Portable</td>\n    <td class=\"yes\">Yes</td>\n    <td class=\"no\">No</td>\n  </tr>\n\n  <tr>\n    <td class=\"benefit-name\">Easy USB Charging</td>\n    <td class=\"yes\">Yes</td>\n    <td class=\"no\">No</td>\n  </tr>\n\n  <tr>\n    <td class=\"benefit-name\">Great for Car, Desk & Home</td>\n    <td class=\"yes\">Yes</td>\n    <td class=\"no\">No</td>\n  </tr>\n</table>",
